# 개발 환경 기본값. 운영 환경에서는 별도의 보안 설정 및 비밀정보 관리가 필요합니다.
SOS_WEB_PORT=9601
SOS_API_PORT=9602
SOS_DB_PORT=9603
SOS_S3_PORT=9605
SOS_DB_USER=sos
SOS_DB_PASSWORD=sos-dev-only
SOS_DB_NAME=sos
SOS_S3_ACCESS_KEY=sos-dev
SOS_S3_SECRET_KEY=sos-dev-secret
SOS_S3_BUCKET=sos-data
SOS_S3_REGION=us-east-1

# 파일 업로드 한도(MiB, 1~2048). 기본값을 변경할 때만 사용.
# SOS_MAX_UPLOAD_MIB=256

# Discovery DuckDB 실행 예산. 워커 수·동시성 및 임시 디스크와 함께 조정.
# SOS_DISCOVERY_MEMORY_MIB=1024
# SOS_DISCOVERY_THREADS=2
# SOS_DISCOVERY_TEMP_MIB=2048
# SOS_DISCOVERY_MAX_GROUPS=100
# SOS_DISCOVERY_MAX_SAMPLE=10000

# 객체 진단 전용 정책. 삭제는 지원하지 않음. 기본값을 변경할 때만 사용.
# SOS_OBJECT_GRACE_DAYS=7
# SOS_OBJECT_OBSERVATION_HOURS=24
# SOS_OBJECT_MIN_OBSERVATIONS=2
# SOS_OBJECT_PAGE_SIZE=100

# 로컬 개발 기본 모드. 이 개발 모드를 외부 프록시로 공개하면 안 됩니다.
# SOS_AUTH_MODE=development
# 사설 토큰 API 운영 테스트용. SHA256(token) -> Actor JSON을 제공해야 합니다.
# SOS_AUTH_MODE=token
# SOS_AUTH_TOKEN_HASHES={"<sha256-of-strong-token>":{"actor_id":"operator-1","kind":"human","roles":["operator"]}}
